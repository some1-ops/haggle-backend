# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — your own keys, since BYOK is being removed.
# Only fill in the ones you actually want live; callChatProvider() will
# throw a clear error for any provider whose key is missing rather than
# failing silently.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Dodo Payments
DODO_WEBHOOK_SECRET=

# Fill in once you have the domain finalized
NEXT_PUBLIC_APP_URL=https://haggle.algeris.com
