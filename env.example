# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — your own keys, since BYOK is being removed.
# Only fill in the ones you actually want live; callChatProvider() will
# throw a clear error for any provider whose key is missing rather than
# failing silently.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Speech Providers (Deepgram, ElevenLabs, Azure Speech, IBM Watson - auto rotates across configured providers)
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
IBM_WATSON_API_KEY=
IBM_WATSON_REGION=us-south
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENDPOINT_ID=
DODO_ENVIRONMENT=test_mode

# Fill in once you have the domain finalized
NEXT_PUBLIC_APP_URL=https://haggle.algeris.com
DODO_WEBHOOK_URL=https://api.haggle.algeris.com/api/webhooks/dodo
