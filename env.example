# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers — backend platform keys.
# Supports MULTIPLE / ALTERNATIVE keys per provider for automatic key rotation & failover.
# You can supply keys as comma-separated strings or with _1, _2, _ALT suffixes:
# Example: HUGGINGFACE_API_KEY="hf_key1,hf_key2" OR HUGGINGFACE_API_KEY_1=hf_key1, HUGGINGFACE_API_KEY_2=hf_key2
HUGGINGFACE_API_KEY=
# HUGGINGFACE_API_KEY_2=
# HF_TOKEN=
# HF_TOKEN_2=

GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_ALT=

GEMINI_API_KEY=
# GEMINI_API_KEY_2=

OPENAI_API_KEY=
# OPENAI_API_KEY_2=

ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_2=

# Speech Providers (Deepgram, ElevenLabs, Azure Speech, IBM Watson, Hugging Face)
# Supports multiple/alternative keys per speech provider (DEEPGRAM_API_KEY_2, ELEVENLABS_API_KEY_2, etc.)
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# DEEPGRAM_API_KEY_2=

ELEVENLABS_API_KEY=
# ELEVENLABS_API_KEY_2=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_KEY_2=

IBM_WATSON_API_KEY=
IBM_WATSON_REGION=us-south
# IBM_WATSON_API_KEY_2=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENDPOINT_ID=
DODO_ENVIRONMENT=test_mode

# App URLs
NEXT_PUBLIC_APP_URL=https://haggle.algeris.com
DODO_WEBHOOK_URL=https://api.algeris.com/api/webhooks/dodo
